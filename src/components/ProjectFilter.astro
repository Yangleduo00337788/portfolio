---
import type { CollectionEntry } from 'astro:content';

type Props = {
  projects: CollectionEntry<'projects'>[];
};

const { projects } = Astro.props;
const tags = [...new Set(projects.flatMap((p) => p.data.tech))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
---

<div class="filter-bar" hidden>
  <div class="filter-bar__row">
    <label class="filter-bar__search">
      <span>搜作品</span>
      <input
        type="search"
        placeholder="标题、简介或技术栈"
        autocomplete="off"
        aria-label="按标题、简介或技术栈搜索作品"
      />
    </label>
    <p class="filter-bar__status" aria-live="polite">
      共 {projects.length} 个作品
    </p>
  </div>

  {
    tags.length > 0 && (
      <ul class="filter-bar__tags">
        <li>
          <button type="button" class="chip chip--all" data-tag="" aria-pressed="true">
            全部
          </button>
        </li>
        {tags.map((tag) => (
          <li>
            <button type="button" class="chip" data-tag={tag} aria-pressed="false">
              {tag}
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .filter-bar__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .filter-bar__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }

  .filter-bar__search input {
    width: min(20rem, 60vw);
    padding: 0.45rem 0.7rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .filter-bar__search input:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .filter-bar__search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    background: var(--bg);
  }

  .filter-bar__status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .filter-bar__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .chip {
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.42rem 0.7rem;
    color: var(--fg-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease), scale 0.12s var(--ease);
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--accent);
  }

  .chip:active {
    scale: 0.95;
  }

  .chip[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
</style>

<script>
  /* 监听挂在 window 上，换页不会自动解绑，所以只注册一次，转调当前页面的还原逻辑 */
  let restoreOnPop: (() => void) | null = null;
  window.addEventListener('popstate', () => restoreOnPop?.());

  /** 挂了 ClientRouter 后这段脚本只跑一次，换页回来的筛选器要靠 astro:page-load 重新接线 */
  const setup = () => {
    const bar = document.querySelector<HTMLElement>('.filter-bar');
    const grid = document.querySelector<HTMLElement>('.project-grid');

    if (!bar || !grid) {
      restoreOnPop = null;
      return;
    }
    if (bar.dataset.ready === '1') return;
    bar.dataset.ready = '1';

    const shells = [...grid.querySelectorAll<HTMLElement>('.card-shell')];
    const input = bar.querySelector<HTMLInputElement>('input[type=search]')!;
    const chips = [...bar.querySelectorAll<HTMLButtonElement>('.chip')];
    const status = bar.querySelector<HTMLElement>('.filter-bar__status')!;
    const empty = document.querySelector<HTMLElement>('.empty');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let activeTag = '';

    /** 计数或提示变了就闪一下，让人看出列表变少不是页面坏了 */
    const say = (text: string) => {
      if (status.textContent === text) return;
      status.textContent = text;
      if (reducedMotion.matches) return;
      status.animate(
        [{ opacity: 0, translate: '0 2px' }, { opacity: 1, translate: '0 0' }],
        { duration: 220, easing: 'ease-out' },
      );
    };

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const shell of shells) {
        const tech = (shell.dataset.tech ?? '').split('|');
        const hitTag = !activeTag || tech.includes(activeTag);
        const hitText = !q || (shell.dataset.search ?? '').includes(q);
        const visible = hitTag && hitText;
        shell.hidden = !visible;
        if (visible) shown += 1;
      }
      if (empty) empty.hidden = shown > 0;
      say(
        shown
          ? `显示 ${shown} / ${shells.length} 个作品`
          : '没有匹配的作品，换个关键词试试',
      );
    };

    const sync = () => {
      const params = new URLSearchParams();
      if (activeTag) params.set('tag', activeTag);
      const q = input.value.trim();
      if (q) params.set('q', q);
      const search = params.toString();
      /* 用 replace 不用 push：每敲一个字压一条历史，后退键就成了翻筛选记录。
         hash 固定带 #projects，复制这条地址发给别人，打开直接落在作品区 */
      history.replaceState(
        history.state,
        '',
        `${location.pathname}${search ? `?${search}` : ''}#projects`,
      );
    };

    const press = (chip: HTMLButtonElement | undefined) => {
      activeTag = chip?.dataset.tag ?? '';
      for (const other of chips) {
        other.setAttribute('aria-pressed', String(other === chip));
      }
    };

    /** 从地址栏还原筛选，认不出的 tag 退回「全部」，免得分享链接一打开是空的 */
    const restore = () => {
      const params = new URLSearchParams(location.search);
      const wanted = chips.find((chip) => chip.dataset.tag === params.get('tag'));
      press(wanted ?? chips.find((chip) => chip.dataset.tag === ''));
      input.value = params.get('q') ?? '';
      apply();
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        press(chip);
        apply();
        sync();
      });
    }

    /* 筛到空了以后，清筛选的路不该只有「手动删搜索框」 */
    document
      .querySelector<HTMLButtonElement>('[data-empty-reset]')
      ?.addEventListener('click', () => {
        input.value = '';
        press(chips.find((chip) => chip.dataset.tag === ''));
        apply();
        sync();
        input.focus();
      });

    input.addEventListener('input', () => {
      apply();
      sync();
    });

    restoreOnPop = restore;

    /* 作品数从 0 跑上去，reduced-motion 下直接留终值 */
    const counter = document.querySelector<HTMLElement>('[data-count]');
    if (counter && !reducedMotion.matches) {
      const target = Number(counter.dataset.count);
      const startedAt = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - startedAt) / 550, 1);
        counter.textContent = String(Math.round(target * (1 - (1 - p) ** 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    /* 筛选依赖 JS，没 JS 时这条整块保持隐藏，作品照常全部显示 */
    restore();
    bar.hidden = false;
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
