---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const { title, year, role, summary, tech, cover } = project.data;
const hue = [...project.id].reduce((acc, c) => acc + c.charCodeAt(0), 0) % 360;
---

<article
  class="card reveal"
  data-tech={tech.join('|')}
  data-search={`${title} ${summary} ${tech.join(' ')}`.toLowerCase()}
>
  <div class="card__cover" style={`--hue: ${hue}`}>
    {
      cover ? (
        /* 卡片最宽约 350px，出图按 2 倍给到 720px，多余的像素不落到访客机器上 */
        <Image
          src={cover}
          alt={`${title} 截图`}
          width={720}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="card__initial" aria-hidden="true">
          {title.slice(0, 1)}
        </span>
      )
    }
  </div>
  <div class="card__body">
    <h3 class="card__title">
      <a href={`/projects/${project.id}`}>{title}</a>
    </h3>
    <p class="card__meta">
      {year}
      {role && ` · ${role}`}
    </p>
    <p class="card__summary">{summary}</p>
    {
      tech.length > 0 && (
        <ul class="tag-list">
          {tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  /* 卡片的 transform 交给 .reveal 动画，hover 只改阴影和封面缩放，
     否则动画的 fill:both 会一直占住 transform，hover 位移不生效 */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elevated);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 10px 28px -14px rgb(0 0 0 / 0.35);
  }

  .card:hover .card__title a {
    text-decoration: none;
    color: var(--accent);
  }

  .card__cover {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(
      140deg,
      hsl(var(--hue, 220) 70% 62% / 0.28),
      hsl(calc(var(--hue, 220) + 45) 70% 58% / 0.14)
    );
    border-bottom: 1px solid var(--border);
  }

  .card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }

  .card:hover .card__cover img {
    transform: scale(1.04);
  }

  .card__initial {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--fg-muted);
    transition: transform 0.45s var(--ease);
  }

  .card:hover .card__initial {
    transform: scale(1.12);
  }

  .card__body {
    padding: 1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card__title {
    font-size: 1.05rem;
    margin: 0;
  }

  .card__title a {
    color: var(--fg);
  }

  /* 整张卡片可点，不用非得点到标题那几个字 */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__meta {
    margin: 0;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  .card__summary {
    margin: 0.2rem 0 0.5rem;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }
</style>
