---
/**
 * 按钮本身不带状态：当前主题由 <html data-theme> 决定，
 * Base.astro 里的内联脚本会在首帧前写好，避免闪烁。
 */
---

<button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
  <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20.5 14.2A8.7 8.7 0 0 1 9.8 3.5a8.7 8.7 0 1 0 10.7 10.7Z" />
  </svg>
  <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  .icon {
    /* 两个图标叠在同一个格子里换透明度，比 display 切换能做出旋转交接 */
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.05rem;
    transition: opacity 0.3s var(--ease), rotate 0.5s var(--ease),
      scale 0.3s var(--ease);
  }

  .icon--sun {
    opacity: 0;
    rotate: -90deg;
    scale: 0.6;
  }

  :root[data-theme='dark'] .icon--moon {
    opacity: 0;
    rotate: 90deg;
    scale: 0.6;
  }

  :root[data-theme='dark'] .icon--sun {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }
</style>

<script>
  const KEY = 'theme';

  const stored = (): string | null => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  const root = document.documentElement;
  const query = matchMedia('(prefers-color-scheme: dark)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const toggle = (button: HTMLButtonElement) => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const rect = button.getBoundingClientRect();
    /* 圆心取按钮中心，圆形擦除从按钮那个点铺开；clip 的坐标是视口像素 */
    root.style.setProperty('--vt-x', `${rect.left + rect.width / 2}px`);
    root.style.setProperty('--vt-y', `${rect.top + rect.height / 2}px`);

    if (reduced.matches || !document.startViewTransition) {
      root.dataset.theme = next;
    } else {
      /* 只在切主题这几帧挂着属性，平时摘掉，免得盖掉路由自己的页面过渡动画 */
      root.dataset.themeVt = '';
      const transition = document.startViewTransition(() => {
        root.dataset.theme = next;
      });
      void transition.finished.finally(() => {
        delete root.dataset.themeVt;
      });
    }

    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* 隐私模式下写不进去，当场切换仍然生效 */
    }
    button.setAttribute('aria-label', next === 'dark' ? '切换到亮色主题' : '切换到深色主题');
  };

  /* 挂了 ClientRouter 之后脚本只执行一次，新页面的按钮要靠 page-load 重新绑定 */
  const bind = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
      if (button.dataset.bound === '1') continue;
      button.dataset.bound = '1';
      button.addEventListener('click', () => toggle(button));
    }
  };

  bind();
  document.addEventListener('astro:page-load', bind);

  /* 路由换页时 Astro 会用新页面的 <html> 属性覆盖当前文档的，
     data-theme 是脚本写的，不在 SSR 输出里，会被整个抹掉变成亮色。
     after-swap 还在同一帧里，赶在浏览器拍新快照之前补回来就不会闪。 */
  document.addEventListener('astro:after-swap', () => {
    const saved = stored();
    root.dataset.theme =
      saved === 'light' || saved === 'dark'
        ? saved
        : query.matches
          ? 'dark'
          : 'light';
  });

  /* 没手动选过就跟着系统走 */
  query.addEventListener('change', (event) => {
    if (stored() === null) root.dataset.theme = event.matches ? 'dark' : 'light';
  });
</script>
