---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../site.config';
import ThemeToggle from '../components/ThemeToggle.astro';
import EmailLink from '../components/EmailLink.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = site.author,
  description = site.tagline,
  image = site.ogImage,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = [
  { label: '作品', href: '/' },
  { label: '关于', href: '/about' },
  { label: '简历', href: '/resume' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <!-- 首帧前定好主题，避免先亮后暗的闪一下 -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <!-- 手机浏览器地址栏/任务栏跟主题走，content 由 ThemeToggle 按当前底色改写 -->
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- 页面切换走 View Transitions；同页锚点要自己接管，见 body 末尾那段 -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <!-- 页头每页都一样，persist 后切页不再参与整页 crossfade，省掉闪一下 -->
    <header class="site-header" transition:persist="site-header">
      <div class="site-header__inner">
        <a class="site-logo" href="/">{site.author}</a>
        <nav class="site-nav" aria-label="主导航">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="site-footer__inner">
        <ul class="inline-links">
          <li>
            © {new Date().getFullYear()} {site.author}
          </li>
          <li>
            <EmailLink />
          </li>
          {
            site.links.map((link) => (
              <li>
                <a href={link.href} rel="noopener noreferrer" target="_blank">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script>
      /**
       * 路由判定同页只看 pathname + search，所以首页筛选写进 ?tag=&q= 之后，
       * 再点「看作品 ↓」这类 #锚点 会被当成跨页导航重新拉一遍整页 —— 换回来的
       * 是没带筛选的 HTML，刚选的条件当场被清空。这里在捕获阶段抢在路由前面，
       * 只接管同路径的锚点：自己滚动、自己写 hash，筛选态和 smooth 滚动都保住。
       */
      document.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const anchor = (event.target as Element | null)?.closest(
            'a[href^="#"]',
          ) as HTMLAnchorElement | null;
          const raw = anchor?.getAttribute('href');
          if (!anchor || !raw || raw === '#') return;

          const target = document.getElementById(decodeURIComponent(raw.slice(1)));
          if (!target) return;

          event.preventDefault();
          history.replaceState(
            history.state,
            '',
            `${location.pathname}${location.search}${raw}`,
          );
          /* 减弱动画的偏好是硬要求，这里写死 smooth 会绕过全局的 scroll-behavior:auto */
          target.scrollIntoView({
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
            block: 'start',
          });
          /* 跳转后要能把焦点落到目标上，读屏用户才跟得住 */
          if (!target.matches('a, button, input, select, textarea, [tabindex]')) {
            target.tabIndex = -1;
          }
          target.focus({ preventScroll: true });
        },
        true,
      );

      /* 页头挂了 transition:persist，换页时这个节点被搬过去而不是重建，
         服务端算好的 aria-current 就停在上一页上，这里跟着地址重新标 */
      const markCurrent = () => {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.site-nav a')) {
          if (link.pathname === path) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
      };
      document.addEventListener('astro:page-load', markCurrent);
    </script>
  </body>
</html>
