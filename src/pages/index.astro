---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { visibleProjects } from '../lib/projects';

const projects = visibleProjects(await getCollection('projects'), import.meta.env.DEV);
---

<Base>
  <section class="hero">
    <h1 class="mask-rise">{site.author}</h1>
    <p class="rise" style="--i: 1">
      {site.role} — {site.tagline}
    </p>
    <p class="rise" style="--i: 2">
      <a href="#projects">看作品 ↓</a>
      <span class="muted"> · </span>
      <a href="/about">关于我</a>
    </p>
  </section>

  <section id="projects">
    <h2>作品（<span data-count={String(projects.length)}>{projects.length}</span>）</h2>
    {projects.length > 1 && <ProjectFilter projects={projects} />}
    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="muted">
          还没有作品。在 <code>src/content/projects/</code> 下新建一个
          <code>.md</code> 文件即可。
        </p>
      )
    }

    {
      projects.length > 0 && (
        <div class="empty" hidden>
          <p>没有符合条件的作品，换个标签或关键词试试。</p>
          <button type="button" class="empty__reset" data-empty-reset>清空筛选</button>
        </div>
      )
    }
  </section>
</Base>

<style>
  /* 筛到零条时整个网格是空的，页面看着像坏了；给一个带出路的占位块 */
  .empty {
    margin-top: 1.75rem;
    padding: 2.5rem 1.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
    color: var(--fg-muted);
  }

  .empty p {
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }

  .empty__reset {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.42rem 0.9rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), scale 0.12s var(--ease);
  }

  .empty__reset:hover {
    border-color: var(--accent);
  }

  .empty__reset:active {
    scale: 0.96;
  }
</style>
