---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { visibleProjects } from '../lib/projects';

const projects = visibleProjects(await getCollection('projects'), import.meta.env.DEV);
---

<Base>
  <section class="hero">
    <h1 class="rise">{site.author}</h1>
    <p class="rise" style="--i: 1">
      {site.role} — {site.tagline}
    </p>
    <p class="rise" style="--i: 2">
      <a href="#projects">看作品 ↓</a>
      <span class="muted"> · </span>
      <a href="/about">关于我</a>
    </p>
  </section>

  <section id="projects">
    <h2>作品（{projects.length}）</h2>
    {projects.length > 1 && <ProjectFilter projects={projects} />}
    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="muted">
          还没有作品。在 <code>src/content/projects/</code> 下新建一个
          <code>.md</code> 文件即可。
        </p>
      )
    }
  </section>
</Base>
