---
import Base from '../../layouts/Base.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { visibleProjects, relatedProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = visibleProjects(await getCollection('projects'), import.meta.env.DEV);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[i - 1],
      next: projects[i + 1],
      related: relatedProjects(project, projects),
    },
  }));
}

const { project, prev, next, related } = Astro.props as {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
  related: CollectionEntry<'projects'>[];
};
const { title, year, role, summary, tech, links, cover, draft } = project.data;
/* 微信 / X / Facebook 不认 SVG 分享图，封面是 svg 时退回站点默认图 */
const shareImage =
  cover && !/\.svg([?#]|$)/i.test(cover.src) ? cover.src : undefined;
const { Content } = await render(project);
---

<Base title={`${title} · 作品集`} description={summary} image={shareImage}>
  <div class="progress-bar" aria-hidden="true"></div>

  <article class="detail">
    <a class="back rise" href="/#projects">← 返回作品列表</a>

    {draft && <p class="draft-note">草稿 · 只有本地 dev 能看到，构建产物里不会生成这一页</p>}

    <h1 class="rise" style="--i: 1">{title}</h1>
    <p class="meta rise" style="--i: 2">
      {year}
      {role && ` · ${role}`}
    </p>

    {
      /* 详情版式最宽 46rem（约 736px），出图给到 1000px 足够覆盖高清屏 */
      cover && (
        <figure class="detail__cover rise" style="--i: 3">
          <Image src={cover} alt={`${title} 截图`} width={1000} decoding="async" />
        </figure>
      )
    }

    <p class="lead rise" style="--i: 4">{summary}</p>

    {
      links?.demo && (
        <a class="action" href={links.demo} rel="noopener noreferrer" target="_blank">
          在线体验
        </a>
      )
    }
    {
      links?.repo && (
        <a class="action action--ghost" href={links.repo} rel="noopener noreferrer" target="_blank">
          源码
        </a>
      )
    }

    {
      tech.length > 0 && (
        <ul class="tag-list">
          {tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <ProjectNav prev={prev} next={next} related={related} />
  </article>
</Base>

<style>
  .detail {
    max-width: 46rem;
  }

  .draft-note {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.3rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.4;
    border-radius: 999px;
    background: #d946a6;
    color: #fff;
  }

  .detail__cover {
    margin: 0 0 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .detail__cover img {
    width: 100%;
  }

  /* 滚进视口时从略大收紧到原尺寸，像照片落定。裁剪靠外层的 overflow: hidden，
     所以过程中只会轻微吃掉边上的像素，到位后就是 1:1 */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .detail__cover img {
        animation-name: cover-settle;
        animation-duration: auto;
        animation-timing-function: var(--ease);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }

      @keyframes cover-settle {
        from {
          scale: 1.06;
        }
        to {
          scale: 1;
        }
      }
    }
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
    transition: translate 0.2s var(--ease), color 0.2s var(--ease);
  }

  .back:hover {
    color: var(--fg);
    text-decoration: none;
    translate: -3px 0;
  }

  .meta {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  .action {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    background: var(--accent);
    color: #fff;
    transition: translate 0.2s var(--ease), box-shadow 0.25s var(--ease),
      filter 0.2s var(--ease), border-color 0.2s var(--ease),
      scale 0.12s var(--ease);
  }

  .action:hover {
    text-decoration: none;
    filter: brightness(1.08);
    translate: 0 -1px;
    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--accent) 75%, transparent);
  }

  .action:active {
    scale: 0.97;
    translate: 0 0;
  }

  .action--ghost {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
    margin-left: 0.5rem;
  }

  .action--ghost:hover {
    filter: none;
    border-color: var(--accent);
    box-shadow: none;
  }

  .detail .tag-list {
    margin: 1.5rem 0 0;
  }

  .prose {
    margin-top: 2.5rem;
  }

  :global(.prose h2) {
    font-size: 1.2rem;
    margin: 2.25rem 0 0.75rem;
  }

  :global(.prose h3) {
    font-size: 1.05rem;
    margin: 1.75rem 0 0.5rem;
  }

  :global(.prose p),
  :global(.prose li) {
    color: var(--fg);
  }

  :global(.prose ul),
  :global(.prose ol) {
    padding-left: 1.25rem;
  }

  :global(.prose img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  :global(.prose code) {
    font-size: 0.88em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.35em;
  }

  /* 背景色交给 Shiki 的双主题，这里只负责外框 */
  :global(.prose pre) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
  }

  :global(.prose pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  :global(.prose blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--fg-muted);
  }
</style>

<script>
  /**
   * 复制按钮和大图遮罩都是这里运行时注入的 DOM，拿不到 Astro 的 scoped 属性，
   * 所以它们的样式在 global.css 的「正文增强」一节里，打印时也在那边隐藏。
   * 接了 ClientRouter 后脚本只执行一次，换页靠 astro:page-load 重新初始化；
   * WeakSet 认的是正文节点，换页后是新节点才会再跑一遍。
   */
  const seen = new WeakSet<Element>();

  /* Esc 监听挂在 document 上，换页不会自己解绑，所以只注册一次，转调当前遮罩 */
  let closeCurrent: (() => void) | null = null;
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeCurrent?.();
  });

  const setup = () => {
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!prose) {
      closeCurrent = null;
      return;
    }
    if (seen.has(prose)) return;
    seen.add(prose);

    if (navigator.clipboard) {
      for (const block of prose.querySelectorAll('pre')) {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy';
        button.textContent = '复制';
        button.addEventListener('click', async () => {
          const code = block.querySelector('code') ?? block;
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            button.textContent = '已复制';
          } catch {
            button.textContent = '复制失败';
          }
          setTimeout(() => (button.textContent = '复制'), 1600);
        });
        block.replaceWith(wrap);
        wrap.append(block, button);
      }
    }

    const images = [...prose.querySelectorAll<HTMLImageElement>('img')];
    if (images.length === 0) {
      closeCurrent = null;
      return;
    }

    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '查看图片大图');
    overlay.hidden = true;
    const big = document.createElement('img');
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'lightbox__close';
    close.textContent = '关闭（Esc）';
    overlay.append(big, close);
    document.body.append(overlay);

    let opener: HTMLImageElement | null = null;
    /* 遮罩开着时 Tab 不该还能跑到后面的正文里：aria-modal 只是声明，
       真正的围栏要靠给正文加 inert。脚本和路由播报节点除外。 */
    const neighbours = () =>
      [...document.body.children].filter(
        (el) => el !== overlay && el.tagName !== 'SCRIPT' && !el.classList.contains('astro-route-announcer'),
      );
    const lock = (on: boolean) => {
      for (const el of neighbours()) {
        if (on) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      }
    };

    const show = (target: HTMLImageElement) => {
      big.src = target.currentSrc || target.src;
      big.alt = target.alt;
      opener = target;
      overlay.hidden = false;
      document.body.classList.add('has-lightbox');
      lock(true);
      /* 让大图从被点小图的正中间长出来：把那个中心换算成大图盒子里的相对坐标。
         getBoundingClientRect 强制同步布局，所以第一帧画出来时 origin 已经是对的 */
      const from = target.getBoundingClientRect();
      const box = big.getBoundingClientRect();
      if (box.width > 0 && box.height > 0) {
        big.style.setProperty('--ox', `${from.left + from.width / 2 - box.left}px`);
        big.style.setProperty('--oy', `${from.top + from.height / 2 - box.top}px`);
      }
      close.focus();
    };
    const hide = () => {
      overlay.hidden = true;
      document.body.classList.remove('has-lightbox');
      lock(false);
      opener?.focus();
    };

    for (const image of images) {
      image.classList.add('is-zoomable');
      image.tabIndex = 0;
      image.addEventListener('click', () => show(image));
      image.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          show(image);
        }
      });
    }

    overlay.addEventListener('click', hide);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !overlay.hidden) hide();
    });
  };

  /* 遮罩开着时被路由换页：正文换了，但 <body> 上的锁滚动标记和挂在页头的 inert
     不会自己掉——页头是 persist 节点，会被原样搬进新页面，带着 inert 就点不动了 */
  document.addEventListener('astro:before-swap', () => {
    document.body.classList.remove('has-lightbox');
    for (const el of document.querySelectorAll('[inert]')) {
      el.removeAttribute('inert');
    }
  });

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
